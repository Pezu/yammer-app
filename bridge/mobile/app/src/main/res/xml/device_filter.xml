<?xml version="1.0" encoding="utf-8"?>
<!-- USB vendor ids the bridge auto-opens for. The Datecs DP-25MX enumerates as a
     USB-serial bridge chip; the exact chip varies by revision, so all common
     serial-bridge vendors are listed. Unknown chips still work via the in-app
     "Conectează USB" button (CDC-ACM fallback). -->
<resources>
    <!-- FTDI -->
    <usb-device vendor-id="1027" />
    <!-- Silicon Labs CP210x -->
    <usb-device vendor-id="4292" />
    <!-- QinHeng CH34x -->
    <usb-device vendor-id="6790" />
    <!-- Prolific PL2303 -->
    <usb-device vendor-id="1659" />
    <!-- Datecs -->
    <usb-device vendor-id="65456" />
</resources>
