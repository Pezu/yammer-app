{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "in-process",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git rebase *)",
      "Bash(git worktree *)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin feature/*)",
      "Bash(git push origin fix/*)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh issue *)",
      "Bash(gh label *)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(mvn *)",
      "Bash(./gradlew *)",
      "Bash(npm *)",
      "Bash(npx playwright *)",
      "Bash(curl *)",
      "Bash(psql *)",
      "mcp__playwright"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin develop*)",
      "Bash(git push origin HEAD:develop*)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh pr create --base main*)",
      "Bash(gh pr create -B main*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gcloud *)",
      "Bash(adb *)",
      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)"
    ]
  }
}
